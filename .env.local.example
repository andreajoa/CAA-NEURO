# Aplicação e autenticação (Clerk)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
CAA_ADMIN_USER_IDS=user_xxx
ADMIN_EMAIL=admin@example.com

# Cloudflare D1 via API REST (execução na Vercel)
CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_D1_DATABASE_ID=xxx
CLOUDFLARE_D1_API_TOKEN=xxx

# Cloudflare R2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=caa-neuro
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com

# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=64_caracteres_hexadecimais

# Voz, imagens e análise clínica
GOOGLE_TTS_API_KEY=xxx
FAL_API_KEY=xxx
GLM_API_KEY=xxx

# Email
RESEND_API_KEY=re_xxx

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_individual
STRIPE_PRICE_ID_CLINICA=price_clinica
STRIPE_PRICE_ID_INSTITUICAO=price_instituicao

# Vercel Cron usa este valor como Authorization: Bearer <CRON_SECRET>
CRON_SECRET=troque_por_um_segredo_longo
